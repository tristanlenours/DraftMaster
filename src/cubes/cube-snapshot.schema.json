{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftmaster.local/schemas/cube-snapshot-v1.json",
  "title": "DraftMaster Cube Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "cubeKey", "version", "source", "cards", "integrity"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+@[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "cubeKey": { "const": "titou_tribal" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "source": { "$ref": "#/$defs/source" },
    "cards": {
      "type": "array",
      "minItems": 360,
      "items": { "$ref": "#/$defs/cardInstance" }
    },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "cubeId",
        "shortId",
        "cubeName",
        "owner",
        "board",
        "url",
        "cubeRevision",
        "cubeUpdatedAt",
        "retrievedAt",
        "importerVersion",
        "rawSha256",
        "attribution"
      ],
      "properties": {
        "provider": { "const": "CubeCobra" },
        "cubeId": { "const": "5e1c13b67c22a016c25ff019" },
        "shortId": { "const": "6ht" },
        "cubeName": { "type": "string", "minLength": 1 },
        "owner": { "const": "eltitou007" },
        "board": { "const": "mainboard" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://cubecobra\\.com/" },
        "cubeRevision": { "type": "integer", "minimum": 1 },
        "cubeUpdatedAt": { "type": "string", "format": "date-time" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "importerVersion": { "type": "string", "minLength": 1 },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },
    "cardInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "sourceIndex",
        "printingId",
        "oracleId",
        "name",
        "setCode",
        "collectorNumber"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^titou_tribal@[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*/mainboard/[0-9]{3,}$"
        },
        "sourceIndex": { "type": "integer", "minimum": 0 },
        "printingId": { "$ref": "#/$defs/uuid" },
        "oracleId": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "setCode": { "type": "string", "pattern": "^[a-z0-9]+$" },
        "collectorNumber": { "type": "string", "minLength": 1 },
        "finish": { "type": "string", "minLength": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cardCount",
        "uniqueInstanceCount",
        "uniquePrintingCount",
        "uniqueOracleCount",
        "canonicalSha256"
      ],
      "properties": {
        "cardCount": { "type": "integer", "minimum": 360 },
        "uniqueInstanceCount": { "type": "integer", "minimum": 360 },
        "uniquePrintingCount": { "type": "integer", "minimum": 1 },
        "uniqueOracleCount": { "type": "integer", "minimum": 1 },
        "canonicalSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
