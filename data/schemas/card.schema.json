{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftmaster.local/schemas/card-v1.json",
  "title": "DraftMaster Card Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "name",
    "oracleId",
    "cmc",
    "colors",
    "colorIdentity",
    "typeLine",
    "types",
    "subtypes",
    "oracleText",
    "keywords",
    "isLand",
    "producesColors",
    "image",
    "powerScore",
    "presentInCubes",
    "objectiveAnalysis",
    "cubeAnalyses"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "oracleId": { "$ref": "#/$defs/uuid" },
    "scryfallId": { "$ref": "#/$defs/uuid" },
    "manaCost": { "type": "string" },
    "cmc": { "type": "number", "minimum": 0 },
    "colors": {
      "type": "array",
      "items": { "$ref": "#/$defs/mtgColor" }
    },
    "colorIdentity": {
      "type": "array",
      "items": { "$ref": "#/$defs/mtgColor" }
    },
    "typeLine": { "type": "string", "minLength": 1 },
    "types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "subtypes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "oracleText": { "type": "string" },
    "frenchName": { "type": "string" },
    "frenchText": { "type": "string" },
    "frenchImageUrl": { "type": "string" },
    "localFrenchPath": { "type": "string" },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "power": { "type": "string" },
    "toughness": { "type": "string" },
    "loyalty": { "type": "string" },
    "isLand": { "type": "boolean" },
    "producesColors": {
      "type": "array",
      "items": { "$ref": "#/$defs/mtgColor" }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "localPath": { "type": "string" },
        "artCropUrl": { "type": "string" },
        "localArtPath": { "type": "string" },
        "localFrenchPath": { "type": "string" },
        "localFrenchArtPath": { "type": "string" }
      }
    },
    "imageUrl": { "type": "string" },
    "powerScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "source", "harmonizationDegree", "confidence", "updatedAt"],
      "properties": {
        "score": { "type": "number", "minimum": 1.0, "maximum": 55.0 },
        "source": {
          "type": "string",
          "enum": ["untapped", "draftsmith", "17lands_normalized", "cubecobra_elo", "expert_heuristic"]
        },
        "rawSourceScore": { "type": "number" },
        "harmonizationDegree": {
          "type": "string",
          "enum": ["native", "calibrated_high", "calibrated_medium", "fallback"]
        },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "presentInCubes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    },
    "objectiveAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "roles", "floorRating", "ceilingRating", "tempoImpact", "quadrantStrengths"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bomb",
              "engine",
              "premium_removal",
              "situational_removal",
              "mana_ramp",
              "mana_fixing",
              "beater",
              "finisher",
              "card_advantage",
              "synergy_enabler",
              "synergy_payoff",
              "cantrip"
            ]
          }
        },
        "floorRating": { "type": "number", "minimum": 1.0, "maximum": 10.0 },
        "ceilingRating": { "type": "number", "minimum": 1.0, "maximum": 10.0 },
        "tempoImpact": { "type": "string", "enum": ["low", "medium", "high"] },
        "quadrantStrengths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opening", "developing", "parity", "behind"],
          "properties": {
            "opening": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
            "developing": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
            "parity": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
            "behind": { "type": "number", "minimum": 1.0, "maximum": 5.0 }
          }
        }
      }
    },
    "cubeAnalyses": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/cubeAnalysis" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "mtgColor": {
      "type": "string",
      "enum": ["W", "U", "B", "R", "G"]
    },
    "cubeAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cubeKey", "fit", "archetypes", "synergyTags", "scoreModifier", "analysis"],
      "properties": {
        "cubeKey": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "fit": {
          "type": "string",
          "enum": ["staple", "build_around", "support", "filler", "trap"]
        },
        "tier": {
          "type": "string",
          "enum": ["S", "A", "B", "C", "D"]
        },
        "archetypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "synergyTags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scoreModifier": { "type": "number", "minimum": -25.0, "maximum": 25.0 },
        "analysis": { "type": "string", "minLength": 1 },
        "pedagogy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "howToPlay": { "type": "string" },
            "keySynergies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cardName", "description"],
                "properties": {
                  "cardName": { "type": "string" },
                  "synergyType": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "archetypeFit": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["colors", "archetype", "grade"],
                "properties": {
                  "colors": { "type": "array", "items": { "$ref": "#/$defs/mtgColor" } },
                  "archetype": { "type": "string" },
                  "grade": {
                    "type": "string",
                    "enum": ["S", "A", "B", "C", "D"]
                  },
                  "winrateOrScore": { "type": "string" },
                  "comment": { "type": "string" }
                }
              }
            }
          }
        },
        "keyPairs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
